# ==============================================================================
# BHARATBHUMI / LAND-STACK CADASTRAL GIS ENVIRONMENT CONFIGURATION
# ==============================================================================

# Default Base Layer ('SATELLITE' | 'BHUNAKSHA' | 'OSM')
VITE_MAP_DEFAULT_LAYER=SATELLITE

# Free High-Resolution Satellite Ortho Imagery (Requires 0 API Keys, 100% Free)
VITE_ESRI_SATELLITE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_ESRI_LABELS_URL=https://services.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}

# BhuNaksha Clean Vector Basemap (CartoDB Light)
VITE_CARTO_LIGHT_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png

# OpenStreetMap Basemap
VITE_OSM_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional API Keys (Leave blank to use pre-configured high-resolution satellite imagery)
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAPBOX_ACCESS_TOKEN=

# State Cadastre Endpoint (MahaBhunaksha NIC GeoServer)
VITE_BHUNAKSHA_WMS_URL=https://bhunaksha.mahabhumi.gov.in/geoserver/wms
