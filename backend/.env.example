# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Supabase Credentials (PostgreSQL)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Authentication Constants (in seconds)
ACCESS_TOKEN_MAX_AGE=900
REFRESH_TOKEN_MAX_AGE=604800
SESSION_MAX_AGE=86400
IDLE_TIMEOUT=1800

# OTP Settings
OTP_MAX_ATTEMPTS=5
OTP_WINDOW_MINUTES=15
OTP_MAX_PER_DAY=10

# Rate Limiting Settings (in milliseconds)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
OTP_RATE_LIMIT_WINDOW=900000
OTP_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=900000
LOGIN_RATE_LIMIT_MAX=10
