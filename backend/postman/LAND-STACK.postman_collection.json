    {
      "name": "Citizen Auth",
      "item": [
        {
          "name": "Request Citizen OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"+91 98230 45891\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/citizen/request-otp", "host": ["{{baseUrl}}"], "path": ["auth", "citizen", "request-otp"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('OTP sent successfully', () => pm.expect(pm.response.json().success).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Citizen OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"+91 98230 45891\",\n  \"otp\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/citizen/verify-otp", "host": ["{{baseUrl}}"], "path": ["auth", "citizen", "verify-otp"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const cookieHeader = pm.response.headers.get('set-cookie');",
                  "  if (cookieHeader) pm.collectionVariables.set('citizenCookie', cookieHeader.split(';')[0]);",
                  "  pm.test('Citizen session verified', () => pm.expect(pm.response.json().data.role).to.eql('CITIZEN'));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
