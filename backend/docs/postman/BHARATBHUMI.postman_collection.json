    {
      "name": "4. Mutations (12-State Workflow)",
      "item": [
        {
          "name": "List Mutations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/mutations?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["mutations"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Initiate Mutation (POST)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parcelUlpin\": \"{{ulpin}}\",\n  \"type\": \"Sale Deed Mutation\",\n  \"buyerName\": \"Rohan Kadam\",\n  \"sellerName\": \"Aarav Patil\",\n  \"remarks\": \"Registered at SRO Haveli\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mutations",
              "host": ["{{baseUrl}}"],
              "path": ["mutations"]
            }
          }
        },
        {
          "name": "Get Mutation by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/mutations/{{mutationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["mutations", "{{mutationId}}"]
            }
          }
        },
        {
          "name": "Submit Field Verification (Talathi)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Mock-Role", "value": "TALATHI" },
              { "key": "X-Mock-User-Id", "value": "off-talathi-01" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remarks\": \"Ground visit conducted. Boundary markers intact.\",\n  \"boundaryChecked\": true,\n  \"photos\": [1, 2]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mutations/{{mutationId}}/field-verify",
              "host": ["{{baseUrl}}"],
              "path": ["mutations", "{{mutationId}}", "field-verify"]
            }
          }
        },
        {
          "name": "Record Formal Objection (Notice Window)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"objectorName\": \"Suresh Jadhav\",\n  \"objectionType\": \"Title Dispute\",\n  \"description\": \"Civil suit pending in Senior Division\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mutations/{{mutationId}}/objections",
              "host": ["{{baseUrl}}"],
              "path": ["mutations", "{{mutationId}}", "objections"]
            }
          }
        },
        {
          "name": "Schedule Dispute Hearing (Tahsildar)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Mock-Role", "value": "TEHSILDAR" },
              { "key": "X-Mock-User-Id", "value": "off-tahsildar-01" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduledDate\": \"2026-10-20T10:00:00.000Z\",\n  \"venue\": \"Tehsildar Court Room No. 2, Haveli\",\n  \"notes\": \"Both parties must present title chain.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mutations/{{mutationId}}/hearings",
              "host": ["{{baseUrl}}"],
              "path": ["mutations", "{{mutationId}}", "hearings"]
            }
          }
        },
        {
          "name": "Approve Mutation (Tahsildar Sanction)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Mock-Role", "value": "TEHSILDAR" },
              { "key": "X-Mock-User-Id", "value": "off-tahsildar-01" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remarks\": \"Verified all notices and panchnama. Sanctioned via DSC.\",\n  \"_mfaToken\": \"mock-mfa-token\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mutations/{{mutationId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["mutations", "{{mutationId}}", "approve"]
            }
          }
        },
        {
          "name": "Reject Mutation (Tahsildar)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Mock-Role", "value": "TEHSILDAR" },
              { "key": "X-Mock-User-Id", "value": "off-tahsildar-01" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Stay order issued by High Court\",\n  \"_mfaToken\": \"mock-mfa-token\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mutations/{{mutationId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["mutations", "{{mutationId}}", "reject"]
            }
          }
        }
      ]
    },
