              "raw": "{{rootUrl}}/health",
              "host": ["{{rootUrl}}"],
              "path": ["health"]
            },
            "description": "Verify server uptime, mode (mock/supabase), and correlation ID."
          }
        },
        {
          "name": "API v1 Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
